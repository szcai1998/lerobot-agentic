# LeRobot Reliability Lab - Environment Variables Template
# Copy this file to .env and insert your actual operational credentials.
# NEVER commit .env to version control.

# Google Gemini API Key (used for semantic high-level recovery expert)
GEMINI_API_KEY=your_gemini_api_key_here

# Hugging Face Hub Token (optional, for downloading gated policy checkpoints / datasets)
HF_TOKEN=your_huggingface_token_here

# Weights & Biases (optional, for remote experiment tracking)
WANDB_API_KEY=your_wandb_api_key_here
